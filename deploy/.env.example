# Shared with the n8n "Tell Claude (dry run)" node (Header Auth, name X-Token). Pick a long random value.
CLAUDE_TRIGGER_TOKEN=
# Google API key (Cloud Console > APIs & Services > Credentials > Create API key; enable "Google Sheets API";
# restrict the key to the Sheets API). Works because the sheets are shared "anyone with the link: viewer".
GOOGLE_API_KEY=
# Sheet ids and per-center mode. Only Liberty Hill is switched on to start.
CENTERS_JSON={"curriculumSheetId":"<curriculum sheet id>","centers":{"Liberty Hill":{"sheetId":"<liberty hill sheet id>","tabs":["Table1 2026","Table2 2026","Table3 2026","Table4 2026"],"generate":"dry-run"}}}
